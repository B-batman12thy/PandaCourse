{
  "name": "pandacourse",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --no-prerender",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:ssr": "npm run build && ng run pandacourse:server",
    "serve:ssr": "node dist/pandacourse/server/main.js",
    "prerender": "ng run pandacourse:prerender",
    "serve:ssr:pandacourse": "node dist/pandacourse/server/server.mjs",
    "lint": "ng lint && prettier --check 'src/**/*.{ts,html,scss}'",
    "format": "prettier --write 'src/**/*.{ts,html,scss}'",
    "mock-api": "json-server --watch db.json --port 3000",
    "test:unit": "jest --passWithNoTests",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:ci": "jest --runInBand",
    "test:coverage": "ng test --code-coverage --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.15",
    "@nguniversal/express-engine": "^7.0.2",
    "@primeng/themes": "^20.0.0",
    "express": "^4.18.2",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-eslint": "20.1.1",
    "autoprefixer": "^10.4.21",
    "cypress": "^14.5.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jasmine-core": "~5.6.0",
    "json-server": "^1.0.0-beta.3",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.34.1"
  }
}
